{
    "name": "phi/phi-indexedsearch",
    "type": "typo3-cms-extension",
    "description": "",
    "authors": [],
    "require": {
        "typo3/cms-core": "^12.4 || ^13.4"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "phi_indexedsearch"
        }
    },
    "autoload": {
        "psr-4": {
            "Phi\\PhiIndexedsearch\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phi\\PhiIndexedsearch\\Tests\\": "Tests"
        }
    },
    "replace": {
        "phi/phi-indexedsearch": "self.version",
        "typo3-ter/phi-indexedsearch": "self.version"
    }
}
